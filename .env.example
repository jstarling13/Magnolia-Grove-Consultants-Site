# ============================================================================
# MAGNOLIA GROVE CONSULTANTS — ENVIRONMENT VARIABLES
# ============================================================================
# Copy this file to .env.local and fill in real values. .env.local is
# git-ignored and never committed. Every integration below degrades
# gracefully when its variables are absent (logged warning instead of a
# crash) EXCEPT where noted, so local dev works without any of these set.
# ============================================================================

# --- Resend (transactional email — admin notification + auto-responder) ---
# https://resend.com/api-keys
# Required for /api/contact to actually deliver mail. Without it, the route
# validates and rate-limits normally but returns a 503 instead of sending.
RESEND_API_KEY=
# Verified sending domain address, e.g. "Magnolia Grove <no-reply@magnoliagrovega.com>"
CONTACT_EMAIL_FROM=
# Inbox that receives lead/strategy-session submissions
CONTACT_EMAIL_TO=contact@magnoliagrovega.com

# --- Cloudflare Turnstile (CAPTCHA) ---
# https://dash.cloudflare.com/?to=/:account/turnstile
# Optional: if both are unset, Turnstile is skipped entirely (widget hidden,
# server-side verification bypassed). Set both to enable bot protection.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Upstash Redis (serverless-safe rate limiting) ---
# https://console.upstash.com/redis
# Optional: if unset, rate limiting is skipped with a logged dev warning.
# Required in production — in-memory rate limiting does not work across
# serverless function invocations (e.g. on Vercel).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Site ---
# Absolute origin used for metadataBase, sitemap, and OG image URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
